# Copy to .env values into your shell/host. Defaults work for local dev.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
# PostgreSQL (leave DB_NAME empty to use SQLite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Email (console backend by default; set these for real SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ShopSphere <no-reply@shopsphere.local>
# Payments: "mock" works out of the box
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
